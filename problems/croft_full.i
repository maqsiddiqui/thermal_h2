# =============================================================================================
# MOOSE PorousFlow model generated by petrel2moose.py
#   2-phase immiscible: phase 0 = water (Water97), phase 1 = gas (methane), isothermal
#   primary variables: pwater (water porepressure, Pa) and sgas (gas saturation)
#   mesh: croft_full.e   (x,y shifted by origin 0.0 0.0;  z = elevation, m)
#   Run:  porous_flow-opt -i <this file>     (or any MOOSE app that includes PorousFlow)
# =============================================================================================

[Mesh]
  [file]
    type = FileMeshGenerator
    file = croft_full.e
    use_for_exodus_restart = true
  []
[]

[GlobalParams]
  PorousFlowDictator = dictator
  gravity = '0 0 -9.81'
[]

[UserObjects]
  [dictator]
    type = PorousFlowDictator
    porous_flow_vars = 'pwater sgas'
    number_fluid_phases = 2
    number_fluid_components = 2
  []
  [pc]
    type = PorousFlowCapillaryPressureConst
    pc = 0
  []
[]

[Variables]
  [pwater]
    initial_from_file_var = p_init_nodal
  []
  [sgas]
    initial_from_file_var = sg_init_nodal
  []
[]

[Functions]
  [p_aq1_fn]   # finite (Fetkovich) aquifer 1: hydrostatic about datum, plus cumulative outflow / (rho V ct)
    type = ParsedFunction
    symbol_names = 'p0 datum_elev rho_w g cum cap'
    symbol_values = '19822555.25 -2028 988.7055039 9.81 aq1_cum_out_kg 235.2864192'
    expression = 'p0 - rho_w * g * (z - datum_elev) + cum / cap'
  []
  [CROFT_1_gas_rate]   # kg/s, + injection / - production
    type = PiecewiseConstant
    direction = LEFT
    x = '0 2592000 5184000 7776000 10368000 12960000
         15552000 18144000 20736000 23328000 25920000 28512000
         31104000 33696000 38880000 41472000 44064000 46656000
         51840000 54432000 57024000 59616000 62208000 64800000
         67392000 69984000 75168000 77760000 80352000 82944000
         85536000 88128000 90720000 93312000 98496000 101088000'
    y = '-0.8991328289 -2.60750177 -2.501406052 -2.784012375 -2.751684093 -2.547522371
         -2.963961044 -3.100148557 -2.814460192 -2.971499481 -4.014106644 -2.367405725
         -2.250371463 0 -0.007480348038 -0.0001135800539 -0.0007811920608 0
         -0.006160471406 -0.3677599491 -0.1672260838 -0.1551055959 -0.05214689402 -0.07764442152
         -0.005392700888 0 -0.04673674103 0 -0.02617815965 0
         -0.089529306 -0.200699224 -0.1745210643 0 -0.02923227828 0'
  []
  [CROFT_1_gas_c0]
    type = ParsedFunction
    symbol_names = 'q'
    symbol_values = 'CROFT_1_gas_rate'
    expression = '0.1217014076 * q'
  []
  [CROFT_1_gas_c1]
    type = ParsedFunction
    symbol_names = 'q'
    symbol_values = 'CROFT_1_gas_rate'
    expression = '0.1107898702 * q'
  []
  [CROFT_1_gas_c2]
    type = ParsedFunction
    symbol_names = 'q'
    symbol_values = 'CROFT_1_gas_rate'
    expression = '0.5285018034 * q'
  []
  [CROFT_1_gas_c3]
    type = ParsedFunction
    symbol_names = 'q'
    symbol_values = 'CROFT_1_gas_rate'
    expression = '0.2390069188 * q'
  []
[]

[AuxVariables]
  [poro]
    family = MONOMIAL
    order = CONSTANT
    initial_from_file_var = poro
  []
  [perm_xx]
    family = MONOMIAL
    order = CONSTANT
    initial_from_file_var = perm_xx
  []
  [perm_yy]
    family = MONOMIAL
    order = CONSTANT
    initial_from_file_var = perm_yy
  []
  [perm_zz]
    family = MONOMIAL
    order = CONSTANT
    initial_from_file_var = perm_zz
  []
  [perm_xy]
    family = MONOMIAL
    order = CONSTANT
    initial_from_file_var = perm_xy
  []
  [mass_frac_phase0_species0]
    initial_condition = 1 # water phase is pure water
  []
  [mass_frac_phase1_species0]
    initial_condition = 0 # gas phase is pure methane
  []
  [p_aq1]   # aquifer 1 pressure seen by its boundary [Pa]
  []
  [aq1_flux]   # nodal mass outflow to aquifer 1 [kg/s] (save_in)
  []
  [swater]
    family = MONOMIAL
    order = CONSTANT
  []
  [gas_density]
    family = MONOMIAL
    order = CONSTANT
  []
[]

[AuxKernels]
  [p_aq1]
    type = FunctionAux
    variable = p_aq1
    function = p_aq1_fn
    execute_on = 'initial timestep_begin'
  []
  [swater]
    type = PorousFlowPropertyAux
    variable = swater
    property = saturation
    phase = 0
    execute_on = timestep_end
  []
  [gas_density]
    type = PorousFlowPropertyAux
    variable = gas_density
    property = density
    phase = 1
    execute_on = timestep_end
  []
[]

[Kernels]
  [mass_water_dot]
    type = PorousFlowMassTimeDerivative
    fluid_component = 0
    variable = pwater
  []
  [flux_water]
    type = PorousFlowAdvectiveFlux
    fluid_component = 0
    variable = pwater
  []
  [mass_gas_dot]
    type = PorousFlowMassTimeDerivative
    fluid_component = 1
    variable = sgas
  []
  [flux_gas]
    type = PorousFlowAdvectiveFlux
    fluid_component = 1
    variable = sgas
  []
[]

[FluidProperties]
  [water]   # from PVTW: rho = rho_sc/Bw * exp(cw (p - pref)), constant viscosity
    type = SimpleFluidProperties
    density0 = 980.1883329
    bulk_modulus = 2279183264
    viscosity = 0.00028317
    thermal_expansion = 0
  []
  [gas]   # from PVDG (Eclipse dry-gas table)
    type = TabulatedBicubicFluidProperties
    fluid_property_file = croft_full_gas_pvt.csv
    interpolated_properties = 'density viscosity'
    out_of_bounds_behavior = set_to_closest_bound
  []
[]

