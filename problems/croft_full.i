    variable = sgas
    mass_flux = q_CROFT_1_gas_c2
    point = '1737.731 1789.268 -1964.464'
  []
  [CROFT_1_gas_c3]   # cell 45,43,4
    type = PorousFlowPointSourceFromPostprocessor
    variable = sgas
    mass_flux = q_CROFT_1_gas_c3
    point = '1737.574 1790.140 -1965.411'
  []
[]

[Postprocessors]
  [aq1_rate_kgps]   # + = water leaving the reservoir into aquifer 1
