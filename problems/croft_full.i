[BCs]
  # aquifer 1 (FETKOVICH): flux out = 6.092335063e-10 * (pwater - p_aq1)  [kg/s/m2]; negative = influx
  [aquifer_1]
    type = PorousFlowPiecewiseLinearSink
    variable = pwater
    boundary = 'aquifer_1_Ip aquifer_1_Jm'
    fluid_phase = 0
    PT_shift = p_aq1
    pt_vals = '-1e9 1e9'
    multipliers = '-0.6092335063 0.6092335063'
    mass_fraction_component = 0
    save_in = aq1_flux
  []
[]

[DiracKernels]
  [CROFT_1_gas_c0]   # cell 45,43,1
    type = PorousFlowPointSourceFromPostprocessor
    variable = sgas
    mass_flux = q_CROFT_1_gas_c0
    point = '1738.046 1787.524 -1962.571'
  []
  [CROFT_1_gas_c1]   # cell 45,43,2
    type = PorousFlowPointSourceFromPostprocessor
    variable = sgas
